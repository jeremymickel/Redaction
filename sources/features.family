table BASE {
    HorizAxis.BaseTagList       ideo  romn;
    HorizAxis.BaseScriptList    DFLT    romn    -150 0,
                                latn    romn    -150 0;
} BASE;

languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn TRK;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn ROM;

@soft_dotted = [i j];
@dotless = [dotlessi dotlessj];
@marks_above = [uni0300 uni0301 uni0302 uni0303 uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];

feature ccmp {
    # i and j lose their dot when a combining mark sits on top (Dutch ij with acutes, etc.)
    lookup soft_dot {
        sub @soft_dotted' @marks_above by @dotless;
    } soft_dot;
    # caron takes the vertical (Slovak) form after d, l, t and L
    lookup caron_alt {
        sub [d l t L] uni030C' by uni030C.alt;
    } caron_alt;
    # i with ogonek loses its dot under a mark: split it into dotless i + combining ogonek
    lookup iogonek_split {
        sub iogonek by dotlessi uni0328;
    } iogonek_split;
    sub iogonek' lookup iogonek_split @marks_above;
} ccmp;

feature locl {
script latn;

	language TRK exclude_dflt;
		lookup IDOT {
			sub i by idotaccent;
		} IDOT;

	language AZE exclude_dflt;
		lookup IDOT;

	language CRT exclude_dflt;
		lookup IDOT;

	language ROM exclude_dflt;
		lookup SCEDILLA {
			sub scedilla by scommaaccent;
			sub Scedilla by Scommaaccent;
			sub Tcedilla by uni021A;
			sub tcedilla by uni021B;
		} SCEDILLA;
} locl;


@fig = [ one two three   ];

@sups = [onesuperior twosuperior threesuperior ];


feature frac {
	sub zero slash zero by percent;
	sub one slash two by onehalf;
	sub one slash four by onequarter;
	sub three slash four by threequarters;
	sub three slash five by uni2157;
} frac;


feature numr {
    sub @fig by @sups;
    } numr;
    
feature sups {
    sub @fig by @sups;
    } sups;
    
